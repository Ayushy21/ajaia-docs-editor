# PostgreSQL connection string. REQUIRED. Used locally and in production.
#
# Production (Vercel): create a database first (Vercel: Storage -> Create Database
# -> Neon Postgres, or use neon.tech / supabase.com for free), then paste its
# connection string here. It must be a real host, not localhost, and usually
# needs ?sslmode=require.
#
#   DATABASE_URL="postgresql://USER:PASSWORD@YOUR-DB-HOST/DBNAME?sslmode=require"
#
# Local development: run Postgres with Docker, then use:
#   docker run -d --name draftspace-db -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

DATABASE_URL=
